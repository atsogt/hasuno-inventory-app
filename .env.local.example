# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domain used to build synthetic login emails from names (name -> name@this-domain)
# Any value works, it's never sent mail. Keep it unique-ish to your org.
AUTH_EMAIL_DOMAIN=hasuno.local

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Shared secret pg_cron sends as a bearer token to the send-reminders Edge Function
# (https://<PROJECT_REF>.functions.supabase.co/send-reminders). Set it as a Supabase
# secret, NOT a Vercel env var - the Next.js app never reads it.
CRON_SECRET=

# Email fallback for reminders (sent alongside push, to profiles.email) via Resend
# (resend.com - free tier, no card required). Both are Supabase secrets, not Vercel
# env vars - only the send-reminders Edge Function reads them. RESEND_FROM_EMAIL must
# be on a domain verified in Resend (or use their onboarding@resend.dev for testing).
# Leave unset to skip email and send push notifications only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
