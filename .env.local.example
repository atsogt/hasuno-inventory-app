# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domain used to build synthetic login emails from names (name -> name@this-domain)
# Any value works, it's never sent mail. Keep it unique-ish to your org.
AUTH_EMAIL_DOMAIN=hasuno.local

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Shared secret the Supabase cron job sends to /api/push/send-reminders
CRON_SECRET=
